# Bluetooth
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# Default BLE Tx power: +3 dBm, the ESP32-C6's closest step below 4 dBm
CONFIG_BT_LE_DFT_TX_POWER_LEVEL_P3=y

# Hubble Network
CONFIG_HUBBLE_BLE_NETWORK=y
CONFIG_HUBBLE_SAT_NETWORK=y

# For logging with with level and timestamp prefix
CONFIG_LOG_VERSION_2=y

# Arduino Nesso N1: 16 MiB flash, console on the native USB Serial/JTAG port
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL fonts used by the UI
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# SNTP: the configured server plus two fallbacks (app_sntp.c)
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# Battery life: scale the CPU down to 40 MHz and light-sleep when idle; the
# BLE controller sleeps between beacons. A USB host keeps it awake so the
# serial console keeps working.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_LE_SLEEP_ENABLE=y
# Required for BLE controller sleep
CONFIG_ESP_PHY_MAC_BB_PD=y
# BLE sleeps on the chip's slow clock so the 40 MHz crystal can power
# down in light sleep; fine for the legacy advertising the beacon uses.
CONFIG_BT_LE_LP_CLK_SRC_DEFAULT=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Battery-life diagnostics: time in light sleep and PM lock holders, logged
# by app_power_log.c, which dumps them from the esp_timer task.
CONFIG_PM_PROFILING=y
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144
